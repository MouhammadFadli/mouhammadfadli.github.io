---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import Achievements from '../../components/sections/Achievements.astro';
import Journey from '../../components/sections/Journey.astro';
import Education from '../../components/sections/Education.astro';
import Media from '../../components/sections/Media.astro';
import Contact from '../../components/sections/Contact.astro';
import { locales, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Achievements lang={lang} />
  <Journey lang={lang} />
  <Education lang={lang} />
  <Media lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
