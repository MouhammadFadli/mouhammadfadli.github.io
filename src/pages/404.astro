---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '../styles/global.css';
import { homeUrl } from '../i18n/utils';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found | Muhammad Fadli</title>
  </head>
  <body class="theme-dark">
    <main>
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p><a class="btn btn--solid" href={homeUrl('en')}>Back to the homepage</a></p>
      <p dir="rtl" lang="ar"><a class="text-link" href={homeUrl('ar')}>العودة إلى الصفحة الرئيسية</a></p>
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    align-content: center;
    min-block-size: 100svh;
    padding: var(--gutter);
  }
  .code {
    color: var(--c-red);
    font-size: clamp(4rem, 14vw, 9rem);
    font-weight: 800;
    line-height: 1;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 800;
  }
</style>
