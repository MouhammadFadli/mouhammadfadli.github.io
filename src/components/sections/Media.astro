---
import Photo from '../Photo.astro';
import { ui } from '../../i18n/ui';
import { links } from '../../data/site';
import type { Locale } from '../../i18n/utils';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const m = t.media;
const [athletic, tech, business] = m.categories;
const f = t.education.fadrox;
---

<section id="media" class="section theme-warm" aria-labelledby="media-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="media-title" class="section-title">{m.title}</h2>
      <p class="lead">{m.intro}</p>
    </div>

    <div class="categories">
      <div class="category reveal" role="group" aria-labelledby="cat-athletic">
        <header class="category__head">
          <h3 id="cat-athletic" class="category__title">{athletic.title}</h3>
          <p class="muted">{athletic.text}</p>
        </header>
        <div class="grid grid--athletic">
          <Photo photo="mediaAction" lang={lang} ratio="4 / 5" caption sizes="(max-width: 44rem) 92vw, 36vw" />
          <Photo photo="mediaRingside" lang={lang} ratio="1 / 1" caption sizes="(max-width: 44rem) 92vw, 30vw" />
          <Photo photo="mediaPodium" lang={lang} ratio="4 / 3" caption sizes="(max-width: 44rem) 92vw, 30vw" widths={[480, 720, 960]} />
        </div>
      </div>

      <div class="category reveal" role="group" aria-labelledby="cat-tech">
        <header class="category__head">
          <h3 id="cat-tech" class="category__title">{tech.title}</h3>
          <p class="muted">{tech.text}</p>
        </header>
        <div class="grid grid--tech">
          <Photo photo="mediaFadroxShop" lang={lang} ratio="1262 / 906" caption sizes="(max-width: 44rem) 92vw, 60vw" widths={[480, 800, 1262]} />
          <div class="note">
            <p class="note__name ltr">{f.name}</p>
            <p class="note__role">{f.role}</p>
            <p class="muted">{f.text}</p>
            <a class="text-link" href={links.fadroxSport} target="_blank" rel="noopener noreferrer">
              {f.cta} <span class="visually-hidden">{t.common.newTab}</span>
            </a>
          </div>
        </div>
      </div>

      <div class="category reveal" role="group" aria-labelledby="cat-business">
        <header class="category__head">
          <h3 id="cat-business" class="category__title">{business.title}</h3>
          <p class="muted">{business.text}</p>
        </header>
        <div class="grid grid--business">
          <Photo photo="storeFloor" lang={lang} ratio="1 / 1" caption sizes="(max-width: 44rem) 92vw, 40vw" widths={[480, 800, 1024]} />
          <Photo photo="storeGear" lang={lang} ratio="4 / 5" caption sizes="(max-width: 44rem) 92vw, 30vw" widths={[480, 800, 1200]} />
          <Photo photo="storeSupplements" lang={lang} ratio="4 / 5" caption sizes="(max-width: 44rem) 92vw, 30vw" widths={[480, 800, 1024]} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .categories {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .category {
    display: grid;
    gap: 1.75rem;
  }
  .category__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.8fr);
    align-items: end;
    gap: 1rem;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid var(--rule);
  }
  .category__title {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: var(--track-display);
  }
  .muted {
    max-inline-size: 38ch;
    color: var(--fg-muted);
  }

  /* Three different compositions: staggered trio, image with a text panel,
     and an uneven trio of store photos. */
  .grid {
    display: grid;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
    align-items: start;
  }
  .grid--athletic {
    grid-template-columns: 1.15fr 0.85fr 1fr;
  }
  .grid--athletic > :nth-child(2) {
    margin-block-start: clamp(2rem, 6vw, 5rem);
  }
  .grid--athletic > :nth-child(3) {
    margin-block-start: clamp(1rem, 3vw, 2.5rem);
  }
  .grid--tech {
    grid-template-columns: 1.7fr 1fr;
    align-items: end;
  }
  .note {
    display: grid;
    gap: 0.6rem;
    padding-block-start: 1.1rem;
    border-block-start: 3px solid var(--c-red);
  }
  .note__name {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
  }
  .note__role {
    font-weight: 800;
  }
  .note .text-link {
    justify-self: start;
    margin-block-start: 0.5rem;
  }
  .grid--business {
    grid-template-columns: 1.3fr 1fr 1fr;
    align-items: end;
  }

  @media (max-width: 44rem) {
    .category__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid--athletic,
    .grid--tech,
    .grid--business {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid--athletic > :nth-child(n) {
      margin-block-start: 0;
    }
  }
</style>
