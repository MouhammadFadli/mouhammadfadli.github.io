---
import Photo from '../Photo.astro';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const a = ui[lang].achievements;
// The Russia camp (last item) is a training experience, not a result.
const trainingIndex = a.items.length - 1;
---

<section id="achievements" class="section theme-warm" aria-labelledby="achievements-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="achievements-title" class="section-title">{a.title}</h2>
      <p class="lead">{a.intro}</p>
    </div>

    <div class="layout">
      <ul class="list">
        {a.items.map((item, i) => (
          <li class:list={['row', { 'row--training': i === trainingIndex }]}>
            <p class="row__tag">{item.tag}</p>
            <div>
              <h3 class="row__title">{item.title}</h3>
              {item.note && <p class="row__note">{item.note}</p>}
            </div>
          </li>
        ))}
      </ul>

      <Photo
        class="layout__photo reveal"
        photo="achievementsPodium"
        lang={lang}
        ratio="4 / 5"
        caption
        sizes="(max-width: 60rem) 90vw, 30vw"
        widths={[480, 720, 960]}
      />
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }
  .layout__photo {
    position: sticky;
    inset-block-start: calc(var(--header-h) + 1.5rem);
  }
  .list {
    border-block-start: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(8.5rem, 1fr) minmax(0, 2.4fr);
    gap: 1rem clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(1.4rem, 3vw, 2.25rem);
    border-block-end: 1px solid var(--rule);
    align-items: baseline;
  }
  .row__tag {
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--c-red);
    color: var(--fg-muted);
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .row__title {
    max-inline-size: 22ch;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: var(--track-display);
  }
  :root:lang(ar) .row__title {
    line-height: 1.5;
  }
  .row__note {
    margin-block-start: 0.6rem;
    color: var(--fg-muted);
  }
  /* A training camp looks different from a result: dashed marker, no red. */
  .row--training .row__tag {
    border-inline-start: 3px dashed var(--fg-muted);
  }
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .layout__photo {
      position: static;
      max-inline-size: 26rem;
    }
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
</style>
