---
import { Image } from 'astro:assets';
import Photo from '../Photo.astro';
import storeLogo from '../../assets/fadli-sport-logo.png';
import { ui } from '../../i18n/ui';
import { links } from '../../data/site';
import type { Locale } from '../../i18n/utils';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const e = t.education;
---

<section id="education" class="section theme-light" aria-labelledby="education-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="education-title" class="section-title">{e.title}</h2>
    </div>

    <div class="study reveal">
      <div class="study__uni">
        <p class="label">{e.universityLabel}</p>
        <h3 class="study__name">{e.universityName}</h3>
        <p class="muted">{e.universityText}</p>
      </div>
      <div>
        <p class="label">{e.interestsLabel}</p>
        <ul class="interests">
          {e.interests.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>

    <div class="brands">
      <div class="brands__head reveal">
        <h3 class="brands__title">{e.brandsTitle}</h3>
        <p class="lead">{e.brandsText}</p>
      </div>

      <div class="brands__grid">
        <article class="project project--site reveal" aria-labelledby="fadrox-name">
          <Photo
            photo="educationFadroxHome"
            lang={lang}
            ratio="1917 / 922"
            sizes="(max-width: 60rem) 92vw, 52vw"
            widths={[640, 960, 1280, 1917]}
          />
          <div class="project__body">
            <p class="label">{e.fadrox.tag}</p>
            <h4 id="fadrox-name" class="project__name ltr">{e.fadrox.name}</h4>
            <p class="project__role">{e.fadrox.role}</p>
            <p class="muted">{e.fadrox.text}</p>
            <a class="text-link" href={links.fadroxSport} target="_blank" rel="noopener noreferrer">
              {e.fadrox.cta} <span class="visually-hidden">{t.common.newTab}</span>
            </a>
          </div>
        </article>

        <article class="project project--store reveal" aria-labelledby="store-name">
          <div class="store__mark">
            <Image
              src={storeLogo}
              alt={e.store.logoAlt}
              format="png"
              widths={[240, 360, 480]}
              sizes="(max-width: 60rem) 14rem, 17rem"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="store__body">
            <p class="label">{e.store.tag}</p>
            <h4 id="store-name" class="project__name">{e.store.name}</h4>
            <p class="project__role">{e.store.role}</p>
            <p>{e.store.text}</p>
            <a class="text-link" href={links.instagramStore} target="_blank" rel="noopener noreferrer">
              {e.store.cta} <span class="visually-hidden">{t.common.newTab}</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--fg-muted);
  }
  .muted {
    color: var(--fg-muted);
  }
  .study {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: 2rem;
    border-block: 1px solid var(--rule);
  }
  .study__uni {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .study__name {
    max-inline-size: 26ch;
    font-size: clamp(1.5rem, 2.8vw, 2.3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: var(--track-display);
  }
  :root:lang(ar) .study__name {
    line-height: 1.55;
  }
  .interests {
    margin-block-start: 0.75rem;
  }
  .interests li {
    padding-block: 0.65rem;
    border-block-end: 1px solid var(--rule);
    font-weight: 700;
  }
  .interests li:last-child {
    border-block-end: 0;
  }

  .brands {
    display: grid;
    gap: 2.25rem;
    margin-block-start: clamp(3.5rem, 8vw, 6rem);
  }
  .brands__head {
    display: grid;
    gap: 0.9rem;
  }
  .brands__title {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--track-display);
  }
  :root:lang(ar) .brands__title {
    line-height: 1.5;
  }
  .brands__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: stretch;
  }
  /* The two brands look different on purpose: an outlined website project
     next to a solid-black business card that carries the Fadli Sport logo. */
  .project {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .project--site {
    gap: 0;
    border: 1.5px solid var(--c-charcoal);
  }
  .project--site :global(.photo) {
    border-block-end: 1.5px solid var(--c-charcoal);
  }
  .project__body {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  /* The store card takes the logo's own near-black (#0a0a0a) so the supplied
     artwork sits in the card instead of on top of it. */
  .project--store {
    --store-bg: #0a0a0a;
    grid-template-rows: minmax(15rem, 1fr) auto;
    gap: 0;
    background: var(--store-bg);
    color: var(--c-paper);
    --link: var(--c-paper);
  }
  .store__mark {
    display: grid;
    place-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-block-end: 1px solid rgb(240 236 231 / 0.16);
  }
  .store__mark :global(img) {
    inline-size: auto;
    block-size: clamp(11rem, 20vw, 16rem);
  }
  .store__body {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3.4vw, 2.5rem);
  }
  .project--store .label {
    color: rgb(240 236 231 / 0.86);
  }
  .project__name {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: var(--track-display);
  }
  :root:lang(ar) .project__name {
    line-height: 1.4;
  }
  .project__role {
    font-weight: 800;
  }
  .project .text-link,
  .store__body .text-link {
    justify-self: start;
    margin-block-start: 0.5rem;
  }
  @media (max-width: 60rem) {
    .study,
    .brands__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
