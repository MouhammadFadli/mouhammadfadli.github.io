---
import Logo from './Logo.astro';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/utils';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang].intro;
---
<div class="intro" id="intro" role="dialog" aria-label={t.label} hidden>
  <button type="button" class="intro__skip" data-skip-intro>{t.skip}</button>
  <div class="intro__stage">
    <Logo class="intro__logo" eager />
    <p class="intro__tag">{t.tagline}</p>
  </div>
</div>

<script>
  // Shows once per session, never with reduced motion. The head script in the layout
  // sets html.intro-run before first paint; this script handles skip and cleanup.
  const el = document.getElementById('intro');
  if (el) {
    if (!document.documentElement.classList.contains('intro-run')) {
      el.remove();
    } else {
      el.hidden = false;
      const done = () => {
        if (!el.isConnected) return;
        document.documentElement.classList.remove('intro-run');
        el.remove();
      };
      const skip = el.querySelector<HTMLButtonElement>('[data-skip-intro]');
      skip?.addEventListener('click', done);
      skip?.focus({ preventScroll: true });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') done(); });
      setTimeout(done, 2400);
    }
  }
</script>

<style>
  .intro { position: fixed; inset: 0; z-index: 200; display: none; place-items: center; background: var(--c-charcoal); color: var(--c-paper); }
  :global(html.intro-run) .intro { display: grid; animation: out 0.5s var(--ease) 1.9s forwards; }
  .intro[hidden] { display: none; }
  .intro__stage { display: grid; justify-items: center; gap: 1.5rem; }
  .intro :global(.intro__logo) { inline-size: auto; block-size: clamp(5.5rem, 17vw, 8.5rem); clip-path: inset(0 100% 0 0); animation: draw 0.9s var(--ease-out) 0.15s forwards; }
  .intro__tag { font-size: clamp(1.1rem, 3vw, 1.6rem); font-weight: 700; opacity: 0; animation: fade 0.6s var(--ease-out) 1.1s forwards; }
  .intro__skip { position: absolute; inset-block-start: 1rem; inset-inline-end: 1rem; min-block-size: 2.75rem; padding: 0.5rem 1.2rem; font: inherit; font-weight: 700; color: var(--c-paper); background: transparent; border: 1.5px solid rgb(240 236 231 / 0.6); cursor: pointer; }
  .intro__skip:hover { background: var(--c-paper); color: var(--c-charcoal); }
  @keyframes draw { to { clip-path: inset(0 0 0 0); } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes out { to { opacity: 0; visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { :global(html.intro-run) .intro { display: none; } }
</style>
