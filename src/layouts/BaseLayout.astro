---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import { links } from '../data/site';
import { dirOf, homeUrl, locales, withBase, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = ui[lang];
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

const ogImage = absolute(withBase(`og/og-${lang}.jpg`));
const ogAlt =
  lang === 'ar'
    ? 'MUHAMMAD FADLI، صورة شخصية مع عبارة صُنعت بالانضباط'
    : 'MUHAMMAD FADLI, portrait with the line Built Through Discipline';

// Structured data: only confirmed facts and confirmed public profiles.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Fadli',
  url: absolute(homeUrl('en')),
  image: absolute(withBase('og/og-en.jpg')),
  email: links.email,
  jobTitle: 'Taekwondo athlete and coach',
  sameAs: [links.instagramPersonal, links.github],
};
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#111111" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={withBase('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />

    <link rel="canonical" href={absolute(homeUrl(lang))} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(homeUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(homeUrl('en'))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammad Fadli" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={absolute(homeUrl(lang))} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.common.skip}</a>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal: headings and large blocks fade in once as they enter view.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }

      // Thin reading-progress line at the top edge.
      const bar = document.querySelector<HTMLElement>('.scroll-progress span');
      let ticking = false;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar?.style.setProperty('transform', `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`);
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true },
      );
      update();
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 120;
    padding: 0.75rem 1.25rem;
    background: var(--c-paper);
    color: var(--c-charcoal);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
  .scroll-progress {
    position: fixed;
    z-index: 100;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    pointer-events: none;
  }
  .scroll-progress span {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    background: var(--c-red);
    transform: scaleX(0);
    transform-origin: left center;
  }
  :root:lang(ar) .scroll-progress span {
    transform-origin: right center;
  }
</style>
